<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Forgot password | XOLUTIONS HUB', pageDescription: 'Set or reset your XOLUTIONS HUB password.', noindex: true }) %></head>
<body>
  <%- include('partials/nav', { activeNav: 'login' }) %>
  <main id="main" tabindex="-1" class="page">
    <div class="wrap page-narrow">
      <div class="auth-card">
        <h1>Set or reset your password</h1>
        <% if (sent) { %>
          <div class="alert alert--ok" role="status">If an account exists for that email, we&rsquo;ve sent a link to set a new password. It expires in 1 hour. Check your spam folder too.</div>
          <p class="hint center"><a href="/login">Back to log in</a></p>
        <% } else { %>
          <p class="sub">Enter the email on your account and we&rsquo;ll email you a one-time link to set a new password.</p>
          <% if (error) { %><div class="error-banner" role="alert"><%= error %></div><% } %>
          <form method="POST" action="/forgot-password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="form-group"><label for="fp-email">Email address</label><input id="fp-email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" /></div>
            <button class="btn btn-block btn-lg" type="submit">Email me a link</button>
          </form>
          <p class="hint center" style="margin-top:var(--s5);">No email arriving? WhatsApp us: <a href="https://wa.me/<%= site.whatsappIntl %>"><%= site.whatsappDisplay %></a></p>
        <% } %>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
