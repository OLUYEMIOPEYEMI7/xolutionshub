<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Set a new password | XOLUTIONS HUB', pageDescription: 'Choose a new password for your XOLUTIONS HUB account.', noindex: true }) %></head>
<body>
  <%- include('partials/nav', { activeNav: 'login' }) %>
  <main id="main" tabindex="-1" class="page">
    <div class="wrap page-narrow">
      <div class="auth-card">
        <h1>Set a new password</h1>
        <p class="sub">For <strong><%= email %></strong>.</p>
        <% if (error) { %><div class="error-banner" role="alert"><%= error %></div><% } %>
        <form method="POST" action="/reset-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="token" value="<%= token %>" />
          <input type="text" name="username" value="<%= email %>" autocomplete="username" hidden />
          <div class="form-group"><label for="rp-pass">New password</label><input id="rp-pass" type="password" name="password" required minlength="8" autocomplete="new-password" aria-describedby="rp-hint" /><p class="hint" id="rp-hint">At least 8 characters.</p></div>
          <div class="form-group"><label for="rp-confirm">Confirm new password</label><input id="rp-confirm" type="password" name="confirm" required minlength="8" autocomplete="new-password" /></div>
          <button class="btn btn-block btn-lg" type="submit">Save password &amp; log in</button>
        </form>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
