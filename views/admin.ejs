<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Admin | XOLUTIONS HUB</title><link rel="stylesheet" href="/css/style.css" /></head>
<body>
  <div class="nav">
    <a href="/" class="brand"><span class="brand-mark">X</span><div><div>XOLUTIONS HUB</div><div class="brand-sub">Admin Dashboard</div></div></a>
    <div class="nav-links"><a href="/" class="navlink">Site</a><form method="POST" action="/logout" style="display:inline;"><button class="btn-outline" type="submit">Logout</button></form></div>
  </div>
  <div style="max-width:1160px; margin:40px auto; padding:0 24px;">
    <h1>All Orders (<%= orders.length %>)</h1>
    <table class="admin-table" style="margin-top:20px;">
      <thead><tr><th>Reference</th><th>Name</th><th>Email</th><th>Total</th><th>Payment</th><th>Status</th><th>Placed</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td><%= o.reference %></td>
            <td><%= o.name %></td>
            <td><%= o.email %></td>
            <td>₦<%= o.grand_total.toLocaleString('en-NG') %></td>
            <td><%= o.payment_status %></td>
            <td><span class="status-pill status-<%= o.order_status %>"><%= o.order_status.replace(/_/g, ' ') %></span></td>
            <td><%= new Date(o.created_at).toLocaleDateString('en-NG') %></td>
            <td><a href="/admin/orders/<%= o.id %>" style="color:var(--navy); font-weight:600;">View →</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
