<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'My Dashboard | XOLUTIONS HUB', pageDescription: 'View and manage your XOLUTIONS HUB project orders.', noindex: true }) %></head>
<body>
  <%- include('partials/nav', { activeNav: 'dashboard' }) %>
  <main id="main" tabindex="-1" class="page">
    <div class="wrap" style="max-width:900px;">
      <p class="eyebrow">Dashboard</p>
      <h1 class="h1">Welcome, <%= student.name %></h1>
      <% if (justPaid) { %><div class="alert alert--ok" role="status"><%- include('partials/icon', {name:'check'}) %> Payment confirmed for order <%= justPaid %>. We'll start working on it right away.</div><% } %>
      <p class="muted">Your orders and their current status.</p>

      <% if (orders.length === 0) { %>
        <div class="order-card"><p class="muted center" style="margin:0;">No orders yet. <a href="/#builder">Place your first order</a>.</p></div>
      <% } %>

      <% orders.forEach(order => { %>
        <article class="order-card" aria-labelledby="o-<%= order.id %>">
          <div class="order-top">
            <div>
              <h2 class="order-ref" id="o-<%= order.id %>"><%= order.reference %></h2>
              <p class="order-date"><%= new Date(order.created_at).toLocaleDateString('en-NG', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>
            <span class="status-pill status-<%= order.order_status %>"><%= order.order_status.replace(/_/g, ' ') %></span>
          </div>
          <%- include('partials/progress', { status: order.order_status }) %>
          <ul class="lines">
            <% (typeof order.items === 'string' ? JSON.parse(order.items) : order.items).forEach(i => { %>
              <li><span><%= i.name %></span><span>₦<%= i.price.toLocaleString('en-NG') %></span></li>
            <% }) %>
          </ul>
          <div class="totals"><div class="row grand"><span>Total</span><span>₦<%= order.grand_total.toLocaleString('en-NG') %></span></div></div>
          <% if (order.admin_notes) { %><div class="alert alert--info"><strong>Note:</strong> <%= order.admin_notes %></div><% } %>

          <h3 class="section-label">Documents</h3>
          <% if (order.documents && order.documents.length > 0) { %>
            <% order.documents.forEach(doc => { %>
              <div class="doc-row"><%- include('partials/icon', {name:'clip', size:14}) %><a href="/documents/<%= doc.id %>/download"><%= doc.originalName %></a> <span class="muted">(<%= doc.uploadedBy %>)</span></div>
            <% }) %>
          <% } else { %>
            <p class="muted" style="margin:0;">No documents uploaded yet.</p>
          <% } %>
          <form method="POST" action="/order/<%= order.id %>/documents" enctype="multipart/form-data" class="upload-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label class="sr-only" for="doc-<%= order.id %>">Choose a document to upload for <%= order.reference %></label>
            <input id="doc-<%= order.id %>" type="file" name="document" required />
            <button class="btn btn-outline btn-sm" type="submit">Upload</button>
          </form>
          <p class="hint">PDF, Word, Excel, PowerPoint, image, text or ZIP. Up to 15MB each.</p>
        </article>
      <% }) %>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
