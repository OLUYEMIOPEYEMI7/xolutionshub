<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Track Your Order | XOLUTIONS HUB', pageDescription: 'Track the status of your XOLUTIONS HUB project support order using your reference number.', noindex: true }) %></head>
<body>
  <%- include('partials/nav', { activeNav: 'track' }) %>
  <main id="main" tabindex="-1" class="page">
  <% if (!order) { %>
    <div class="wrap page-narrow">
      <div class="auth-card">
        <h1>Track your order</h1>
        <p class="sub">Enter your order reference and the email you used to check its status.</p>
        <% if (error) { %><div class="error-banner" role="alert"><%= error %></div><% } %>
        <form method="POST" action="/track">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-group"><label for="t-ref">Order reference</label><input id="t-ref" type="text" name="reference" required value="<%= prefillRef %>" placeholder="XH-..." autocomplete="off" /></div>
          <div class="form-group"><label for="t-email">Email address</label><input id="t-email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" /></div>
          <button class="btn btn-block btn-lg" type="submit">Track order</button>
        </form>
      </div>
    </div>
  <% } else { %>
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Order status</p>
      <h1 class="h1"><%= order.reference %></h1>
      <p class="order-date" style="margin-bottom:var(--s5);">Placed <%= new Date(order.created_at).toLocaleDateString('en-NG', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      <div class="order-card">
        <span class="status-pill status-<%= order.order_status %>"><%= order.order_status.replace(/_/g, ' ') %></span>
        <%- include('partials/progress', { status: order.order_status }) %>
        <% if (order.payment_status !== 'paid' && order.order_status === 'awaiting_payment') { %>
          <h2 class="section-label">How to pay</h2>
          <%- include('partials/payment-steps', { order }) %>
        <% } %>
        <h2 class="section-label">Services</h2>
        <ul class="lines">
          <% (typeof order.items === 'string' ? JSON.parse(order.items) : order.items).forEach(i => { %>
            <li><span><%= i.name %></span><span>₦<%= i.price.toLocaleString('en-NG') %></span></li>
          <% }) %>
        </ul>
        <div class="totals">
          <div class="row"><span>Services</span><span>₦<%= order.services_total.toLocaleString('en-NG') %></span></div>
          <div class="row"><span>Handling</span><span>₦<%= order.handling_total.toLocaleString('en-NG') %></span></div>
          <div class="row grand"><span>Total</span><span>₦<%= order.grand_total.toLocaleString('en-NG') %></span></div>
        </div>
        <% if (order.admin_notes) { %><div class="alert alert--info"><strong>Note from the team:</strong> <%= order.admin_notes %></div><% } %>
      </div>
      <p class="muted">Need to upload a document or message us? WhatsApp <a href="https://wa.me/<%= site.whatsappIntl %>"><%= site.whatsappDisplay %></a>, or <a href="/login">log in to your dashboard</a>.</p>
    </div>
  <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
