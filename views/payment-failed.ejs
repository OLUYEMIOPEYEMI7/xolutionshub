<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Payment Not Completed | XOLUTIONS HUB', pageDescription: 'Your payment could not be confirmed.', noindex: true }) %></head>
<body>
  <%- include('partials/nav') %>
  <main id="main" tabindex="-1" class="page">
    <div class="wrap page-narrow">
      <div class="auth-card">
        <h1>Payment not completed</h1>
        <p class="sub">Your payment for order <strong><%= order ? order.reference : '' %></strong> could not be confirmed. No charge was made, or it was declined.</p>
        <a href="/#builder" class="btn btn-block btn-lg">Try again</a>
        <p class="hint center" style="margin-top:var(--s5);">Need help? WhatsApp <a href="https://wa.me/<%= site.whatsappIntl %>"><%= site.whatsappDisplay %></a></p>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
