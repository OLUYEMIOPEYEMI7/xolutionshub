<%
  // Bank-transfer instructions for one order. Expects `order`; `headingLevel` (default 3) keeps the outline valid.
  const _h = 'h' + (typeof headingLevel !== 'undefined' ? headingLevel : 3);
  const _amount = '₦' + Number(order.grand_total).toLocaleString('en-NG');
  const _waText = 'Hello XOLUTIONS HUB, I have paid ' + _amount + ' by bank transfer for order ' + order.reference + '. My payment receipt is attached.';
  const _waUrl = 'https://wa.me/' + site.whatsappIntl + '?text=' + encodeURIComponent(_waText);
%>
<ol class="pay-steps">
  <li>
    <<%= _h %>>Transfer <%= _amount %></<%= _h %>>
    <% if (site.bankConfigured) { %>
      <dl class="bank">
        <div><dt>Bank</dt><dd><%= site.bank.name %></dd></div>
        <div><dt>Account name</dt><dd><%= site.bank.accountName %></dd></div>
        <div><dt>Account number</dt><dd><span class="mono" id="acct-<%= order.id %>"><%= site.bank.accountNumber %></span> <button type="button" class="copy-btn" data-copy="<%= site.bank.accountNumber %>">Copy</button></dd></div>
        <div><dt>Amount</dt><dd><%= _amount %></dd></div>
        <div><dt>Narration / description</dt><dd><span class="mono"><%= order.reference %></span> <button type="button" class="copy-btn" data-copy="<%= order.reference %>">Copy</button></dd></div>
      </dl>
    <% } else { %>
      <p>Message us on WhatsApp with your order reference and we&rsquo;ll send our bank account details.</p>
    <% } %>
  </li>
  <li>
    <<%= _h %>>Send your receipt on WhatsApp</<%= _h %>>
    <p>Send a screenshot or PDF of your transfer receipt to <strong><%= site.whatsappDisplay %></strong>. The button below opens WhatsApp with your reference filled in. Attach the receipt before sending.</p>
    <a class="btn btn-whatsapp" href="<%= _waUrl %>" target="_blank" rel="noopener noreferrer"><%- include('icon', {name:'whatsapp', size:15}) %> Send receipt on WhatsApp</a>
  </li>
  <li>
    <<%= _h %>>We confirm and start</<%= _h %>>
    <p>Once we&rsquo;ve checked your payment, your order moves into our queue and we email you. Follow progress any time on <a href="/track?ref=<%= encodeURIComponent(order.reference) %>">Track order</a>.</p>
  </li>
</ol>
<p class="copy-status sr-only" aria-live="polite"></p>
