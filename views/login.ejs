<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Login | XOLUTIONS HUB', pageDescription: 'Log in to your XOLUTIONS HUB account to track orders and upload documents.', noindex: true }) %></head>
<body>
  <%- include('partials/nav', { activeNav: 'login' }) %>
  <main id="main" tabindex="-1" class="page">
    <div class="wrap page-narrow">
      <div class="auth-card">
        <h1>Welcome back</h1>
        <p class="sub">Log in to view your orders and upload documents. Your account is created when we confirm the payment for your first order. Check that email for the link to set your password.</p>
        <% if (error) { %><div class="error-banner" role="alert"><%= error %></div><% } %>
        <form method="POST" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-group"><label for="l-email">Email address</label><input id="l-email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" /></div>
          <div class="form-group"><label for="l-pass">Password</label><input id="l-pass" type="password" name="password" required autocomplete="current-password" /></div>
          <button class="btn btn-block btn-lg" type="submit">Log in</button>
        </form>
        <p class="hint center" style="margin-top:var(--s5);">Forgot your password, or never set one? WhatsApp us: <a href="https://wa.me/<%= site.whatsappIntl %>"><%= site.whatsappDisplay %></a></p>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
