<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Order ' + order.reference + ' | Admin', pageDescription: 'Admin order detail.', noindex: true }) %></head>
<body>
  <%- include('partials/nav', { activeNav: 'dashboard' }) %>
  <main id="main" tabindex="-1" class="page">
    <div class="wrap" style="max-width:900px;">
      <p><a href="/admin">&larr; All orders</a></p>
      <h1 class="h1"><%= order.reference %></h1>
      <p class="muted" style="margin:0;"><%= order.name %> &middot; <%= order.email %> &middot; <%= order.phone || 'No phone' %></p>
      <p class="muted"><%= order.institution || 'No institution listed' %> &middot; <%= order.level || '—' %></p>

      <% if (flash === 'paid') { %><div class="alert alert--ok" role="status">Payment confirmed. The order is in the queue, the student's account is linked, and a confirmation email was sent (if email is configured).</div><% } %>
      <% if (flash === 'payment') { %><div class="alert alert--info" role="status">Payment status updated.</div><% } %>

      <div class="order-card">
        <h2 class="section-label" style="margin-top:0;">Payment (bank transfer)</h2>
        <p style="margin-bottom:var(--s3);">Expected amount <strong>₦<%= order.grand_total.toLocaleString('en-NG') %></strong> with narration <strong class="mono"><%= order.reference %></strong>. Check the receipt sent on WhatsApp against your bank statement before confirming.</p>
        <form method="POST" action="/admin/orders/<%= order.id %>/payment" class="upload-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label for="payment-status-select" class="sr-only">Payment status</label>
          <select name="paymentStatus" id="payment-status-select" class="inline-select">
            <% ['pending','paid','failed'].forEach(s => { %>
              <option value="<%= s %>" <%= order.payment_status === s ? 'selected' : '' %>><%= s === 'paid' ? 'paid (confirmed received)' : s %></option>
            <% }) %>
          </select>
          <button class="btn btn-sm" type="submit">Save payment status</button>
        </form>
        <p class="hint">Setting it to paid for the first time moves a waiting order into the queue, creates or links the student account, and emails them.</p>
      </div>

      <div class="order-card">
        <span class="status-pill status-<%= order.order_status %>"><%= order.order_status.replace(/_/g, ' ') %></span>
        <span class="status-pill pill-neutral" style="margin-left:var(--s2);">Payment: <%= order.payment_status %></span>

        <h2 class="section-label">Project</h2>
        <dl class="dl">
          <div><dt>Topic</dt><dd><%= order.project_topic || 'Not specified' %></dd></div>
          <div><dt>Description</dt><dd><%= order.project_description || 'None provided' %></dd></div>
        </dl>

        <h2 class="section-label">Services</h2>
        <ul class="lines">
          <% (typeof order.items === 'string' ? JSON.parse(order.items) : order.items).forEach(i => { %>
            <li><span><%= i.name %></span><span>₦<%= i.price.toLocaleString('en-NG') %></span></li>
          <% }) %>
        </ul>
        <div class="totals">
          <div class="row"><span>Services</span><span>₦<%= order.services_total.toLocaleString('en-NG') %></span></div>
          <div class="row"><span>Handling (<%= order.delivery_speed %>)</span><span>₦<%= order.handling_total.toLocaleString('en-NG') %></span></div>
          <div class="row grand"><span>Total</span><span>₦<%= order.grand_total.toLocaleString('en-NG') %></span></div>
        </div>

        <h2 class="section-label">Documents</h2>
        <% if (documents.length === 0) { %><p class="muted" style="margin:0;">No documents uploaded.</p><% } %>
        <% documents.forEach(doc => { %>
          <div class="doc-row"><%- include('partials/icon', {name:'clip', size:14}) %><a href="/documents/<%= doc.id %>/download"><%= doc.originalName %></a> <span class="muted">(<%= doc.uploadedBy %>, <%= new Date(doc.createdAt).toLocaleDateString('en-NG') %>)</span></div>
        <% }) %>

        <h2 class="section-label">Update status</h2>
        <form method="POST" action="/admin/orders/<%= order.id %>/status">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-group">
            <label for="order-status-select">Order status</label>
            <select name="orderStatus" id="order-status-select">
              <% ['awaiting_payment','in_queue','in_progress','review','completed','cancelled'].forEach(s => { %>
                <option value="<%= s %>" <%= order.order_status === s ? 'selected' : '' %>><%= s.replace(/_/g, ' ') %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group"><label for="admin-notes">Note to student (optional)</label><textarea id="admin-notes" name="adminNotes"><%= order.admin_notes || '' %></textarea></div>
          <button class="btn" type="submit">Update order</button>
        </form>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
